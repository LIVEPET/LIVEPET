PROJECT_NAME="LivePet API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Conexão de Banco de Dados:
# Para desenvolvimento local autônomo (SQLite):
DATABASE_URL="sqlite:///./livepet.db"
# Para produção / conexão com PostgreSQL (Supabase/Neon):
# DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"

# Chave secreta para JWT (autenticação de tutores)
SECRET_KEY="livepet-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origens permitidas para CORS (separadas por vírgula)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080"
